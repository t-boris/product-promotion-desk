{
  "name": "product-promotion-desk",
  "productName": "Product Promotion Desk",
  "version": "0.7.1",
  "description": "Personal macOS application that helps promote products using an installed Codex or Claude Code as the AI engine.",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "author": "Boris Tsekinovsky",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "npm run rebuild:electron && electron-vite dev",
    "build": "electron-vite build",
    "start": "npm run rebuild:electron && electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "lint": "eslint .",
    "test": "npm run rebuild:node && vitest run",
    "test:watch": "npm run rebuild:node && vitest",
    "rebuild:node": "npm rebuild better-sqlite3",
    "rebuild:electron": "electron-builder install-app-deps",
    "dist": "npm run build && npm run rebuild:electron && electron-builder --mac --arm64 --dir",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build",
    "deploy:local": "npm run dist && node scripts/deploy-local.mjs"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "^22.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "eslint": "10.14.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
